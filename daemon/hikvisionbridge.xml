<service>
	<id>hikvisionbridge.exe</id>
	<name>HikvisionBridge</name>
	<description>Hikvision Middleware For Odoo</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\hikvision_middleware\hikvision-middleware\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\hikvision_middleware\hikvision-middleware\index.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>HikvisionBridge wrapper</argument>
	<argument>--grow</argument>
	<argument>0.5</argument>
	<argument>--wait</argument>
	<argument>2</argument>
	<argument>--maxrestarts</argument>
	<argument>3</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<argument>--maxretries</argument>
	<argument>999</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<serviceaccount>
		<domain>WIN-2H0867698UE</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\hikvision_middleware\hikvision-middleware</workingdirectory>
</service>